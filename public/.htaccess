# A public/ a webes rész. A gyökér .htaccess ide irányít minden kérést;
# a saját RewriteEngine miatt a gyökér szabályai itt nem futnak le újra.
Options -Indexes -MultiViews
# A mappákhoz ne fűzzön automatikusan perjelet (az /admin-t lent kezeljük)
DirectorySlash Off
<IfModule mod_rewrite.c>
    RewriteEngine On
    # /admin (perjel nélkül) → a szerkesztő, a /public/ útvonal felfedése nélkül
    RewriteRule ^admin$ admin/index.php [L,QSA]
    RewriteRule ^fiok$ fiok/index.php [L,QSA]

    # OAuth-bejelentkezés (a Claude és más AI-k ezen keresztül kapcsolódnak)
    RewriteRule ^\.well-known/oauth-authorization-server$ oauth/metadata.php?doc=as [L]
    RewriteRule ^\.well-known/oauth-protected-resource(/.*)?$ oauth/metadata.php?doc=pr [L]
    RewriteRule ^oauth/(authorize|token|register)$ oauth/$1.php [L,QSA]
</IfModule>
