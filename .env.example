# Másold le .env néven, ha módosítani akarod a portokat vagy jelszavakat.
WEB_PORT=8100
# DB_PORT=3307  (csak ha a docker-compose.yml-ben bekapcsolod)
ADMINER_PORT=8101
TARHELY_PORT=8102
DB_NAME=adventure
DB_USER=adventure
DB_PASS=adventure
DB_ROOT_PASS=rootpass

# Prototípus: melyik játékos nevében fut az MCP-szerver
PLAYER_ID=1
# Az MCP-végpontot elérő host-nevek, vesszővel. A Cloudflare-alagút címét ide kell felvenni,
# pl.: localhost,127.0.0.1,valami-nev.trycloudflare.com
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
